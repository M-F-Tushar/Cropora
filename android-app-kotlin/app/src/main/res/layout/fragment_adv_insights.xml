<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="120dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp">

        <TextView
            style="@style/AdvText.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/adv_nav_insights" />

        <TextView
            android:id="@+id/advInsightsSubtitle"
            style="@style/AdvText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:id="@+id/advInsightsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Health split -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Cropora.Adv.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <FrameLayout
                        android:layout_width="136dp"
                        android:layout_height="136dp">

                        <com.cropora.DonutChartView
                            android:id="@+id/advInsightsDonut"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_horizontal"
                            android:importantForAccessibility="noHideDescendants"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/advInsightsTotal"
                                style="@style/AdvText.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                style="@style/AdvText.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/adv_total_scans_caption" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/advInsightsLegendHealthy"
                            layout="@layout/item_adv_legend" />

                        <include
                            android:id="@+id/advInsightsLegendDiseased"
                            layout="@layout/item_adv_legend" />

                        <include
                            android:id="@+id/advInsightsLegendReview"
                            layout="@layout/item_adv_legend" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Metrics grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Cropora.Adv.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/advInsightsAvg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/advInsightsAvgRing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:max="100"
                            app:indicatorColor="@color/adv_primary"
                            app:indicatorSize="40dp"
                            app:trackColor="@color/adv_primary_soft"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="5dp" />

                        <TextView
                            android:id="@+id/advInsightsAvgValue"
                            style="@style/AdvText.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                        <TextView
                            style="@style/AdvText.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/adv_avg_confidence" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp" />

                <include
                    android:id="@+id/advInsightsReview"
                    layout="@layout/item_adv_metric" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/advInsightsLocation"
                    layout="@layout/item_adv_metric" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp" />

                <include
                    android:id="@+id/advInsightsDiseases"
                    layout="@layout/item_adv_metric" />
            </LinearLayout>

            <!-- Most common result -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Cropora.Adv.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/advInsightsTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/advInsightsTopAvatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AdvText.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/adv_most_common" />

                        <TextView
                            android:id="@+id/advInsightsTopName"
                            style="@style/AdvText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/advInsightsTopCount"
                        style="@style/AdvText.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Last seven days -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Cropora.Adv.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/AdvText.Section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:text="@string/adv_last_7_days" />

                        <TextView
                            android:id="@+id/advInsightsWeekCount"
                            style="@style/AdvText.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <com.cropora.BarChartView
                        android:id="@+id/advInsightsBars"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Top results -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Cropora.Adv.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/AdvText.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/adv_top_results" />

                    <LinearLayout
                        android:id="@+id/advInsightsTopList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <include
            android:id="@+id/advInsightsEmpty"
            layout="@layout/view_adv_empty"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- "Care plan" heading followed by signs, treatment and prevention cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/AdvText.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:accessibilityHeading="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/adv_care_plan" />

    <!-- Signs -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Cropora.Adv.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/adv_bg_icon_badge"
                    android:backgroundTint="@color/adv_warn_soft">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/adv_ic_eye"
                        app:tint="@color/adv_warn" />
                </FrameLayout>

                <TextView
                    style="@style/AdvText.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/adv_care_signs"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/advCareSigns"
                style="@style/AdvText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/guidance_unavailable"
                android:textIsSelectable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Treatment -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Cropora.Adv.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/adv_bg_icon_badge"
                    android:backgroundTint="@color/adv_healthy_soft">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/adv_ic_treatment"
                        app:tint="@color/adv_healthy" />
                </FrameLayout>

                <TextView
                    style="@style/AdvText.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/adv_care_treatment"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/advCareTreatment"
                style="@style/AdvText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/guidance_unavailable"
                android:textIsSelectable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Prevention -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Cropora.Adv.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/adv_bg_icon_badge"
                    android:backgroundTint="@color/adv_info_soft">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/adv_ic_shield"
                        app:tint="@color/adv_info" />
                </FrameLayout>

                <TextView
                    style="@style/AdvText.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/adv_care_prevention"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/advCarePrevention"
                style="@style/AdvText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/guidance_unavailable"
                android:textIsSelectable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

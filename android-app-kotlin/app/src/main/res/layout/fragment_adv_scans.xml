<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp">

        <TextView
            style="@style/AdvText.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/adv_nav_scans" />

        <TextView
            android:id="@+id/advScansCount"
            style="@style/AdvText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/advScansFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/advFilterAll"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/advFilterAll"
                style="@style/Widget.Cropora.Adv.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adv_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/advFilterHealthy"
                style="@style/Widget.Cropora.Adv.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adv_healthy" />

            <com.google.android.material.chip.Chip
                android:id="@+id/advFilterDiseased"
                style="@style/Widget.Cropora.Adv.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adv_diseased" />

            <com.google.android.material.chip.Chip
                android:id="@+id/advFilterReview"
                style="@style/Widget.Cropora.Adv.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adv_needs_review" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/advScansList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="120dp" />

        <ScrollView
            android:id="@+id/advScansEmptyScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="120dp"
            android:visibility="gone">

            <include
                android:id="@+id/advScansEmpty"
                layout="@layout/view_adv_empty" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>

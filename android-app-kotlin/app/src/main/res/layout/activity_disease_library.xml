<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/screen_background">

    <!-- Attached as a RecyclerView header only in advanced mode. -->
    <LinearLayout
        android:id="@+id/referenceLibraryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/reference_header"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_library"
                app:tint="#D3EEE1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/reference_library_eyebrow"
                android:textColor="#D3EEE1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/referenceLibraryHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/library_title"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/reference_library_intro"
                android:textColor="#E4F2EB"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/reference_card_signs"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/referenceLibrarySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reference_library_section"
                android:textColor="#70460D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/reference_library_hint"
                android:textColor="#655238"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/referenceLibraryLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/disease_library_loading"
            android:visibility="gone" />

        <TextView
            android:id="@+id/referenceLibraryState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:padding="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/textLibraryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/library_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/textLibraryDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/library_description"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/progressLibrary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/disease_library_loading" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDiseases"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textLibraryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/disease_library_empty"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

</LinearLayout>

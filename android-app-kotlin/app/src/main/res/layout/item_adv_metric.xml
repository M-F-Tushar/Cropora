<?xml version="1.0" encoding="utf-8"?>
<!-- Square-ish metric tile: icon badge, big value and a label. Icon and colors are set in code. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Cropora.Adv.Card"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/advMetricBadge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/adv_bg_icon_badge">

            <ImageView
                android:id="@+id/advMetricIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/advMetricValue"
            style="@style/AdvText.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/advMetricLabel"
            style="@style/AdvText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/workspaceHomeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/workspace_header"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/workspace_badge"
                android:padding="8dp"
                android:text="@string/workspace_research_label"
                android:textColor="#D8F6E8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/workspace_home_title"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/workspace_home_intro"
                android:textColor="#D8F6E8"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Header Hero Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/workspaceHomeNormalHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/leaf_surface"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_leaf"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textHomeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_title"
                        android:textColor="@color/leaf_green_dark"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textHomeSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/workspaceHomeWorkflow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#EEF4FD"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#C3D3EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/workspace_workflow_title"
                    android:textColor="#203F68"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/workspace_workflow_intro"
                    android:textColor="#3D526D"
                    android:textSize="15sp" />

                <com.cropora.WorkflowDiagramView
                    android:id="@+id/workspaceHomeDiagram"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/workspace_home_workflow_note"
                    android:textColor="#3D526D"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Action: Plant Scan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenScan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/open_scan"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_camera_scan"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:backgroundTint="@color/leaf_green"
            app:cornerRadius="12dp"
            app:elevation="3dp" />

        <!-- Quick Access Section -->
        <TextView
            android:id="@+id/workspaceHomeToolsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/quick_actions"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/workspaceHomeToolsIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFF2D9"
            android:padding="16dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/workspace_tools_intro"
            android:textColor="#65471C"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenResult"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:text="@string/open_result"
            android:textColor="@color/leaf_green_dark"
            app:icon="@drawable/ic_sample_result"
            app:iconTint="@color/leaf_green_dark"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:strokeColor="@color/leaf_green"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenHistory"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/open_history"
            android:textColor="@color/leaf_green_dark"
            app:icon="@drawable/ic_history"
            app:iconTint="@color/leaf_green_dark"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:strokeColor="@color/leaf_green"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenLibrary"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/open_library"
            android:textColor="@color/leaf_green_dark"
            app:icon="@drawable/ic_library"
            app:iconTint="@color/leaf_green_dark"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:strokeColor="@color/leaf_green"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenSettings"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/open_settings"
            android:textColor="@color/leaf_green_dark"
            app:icon="@drawable/ic_settings"
            app:iconTint="@color/leaf_green_dark"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:strokeColor="@color/leaf_green"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenAnalytics"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/open_analytics"
            android:textColor="@color/leaf_green_dark"
            app:icon="@drawable/ic_analytics"
            app:iconTint="@color/leaf_green_dark"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:strokeColor="@color/leaf_green"
            app:cornerRadius="10dp" />

    </LinearLayout>
</ScrollView>